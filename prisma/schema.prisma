// 나의 방 (my-heritage) — 데이터 모델
//
// SoT: my-heritage-planning
//   골격(엔티티·관계·M-01~M-14) → projects/myroom-service/drafts/02-planning-spec.md §5
//   필드 상세                   → 각 하위 프로젝트 PRD / Planning Spec
//
// ⚠️ 이 스키마는 확정된 결정(D-xxx)만 반영한다. 문서에 근거가 없는 필드를 추측으로
//    추가하지 않는다 (planning CLAUDE.md 에이전트 공통 규칙 9).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// ko/ja/en 3개 모두 1급 언어 (D-003)
enum Locale {
  ko
  ja
  en
}

/// 판매자 지정 통화 그대로 표시. 환산하지 않는다 (D-011)
enum Currency {
  KRW
  JPY
  USD
}

/// D-021 — Google / Apple 소셜만. 이메일·비밀번호 가입 없음
enum AuthProvider {
  GOOGLE
  APPLE
}

enum Visibility {
  PUBLIC
  PRIVATE
}

/// myroom-service §3-3 / market §1
enum ItemSaleStatus {
  DISPLAYED /// 전시중 — 마켓 미노출
  ON_SALE /// 판매중 — 마켓 노출. 가격·통화·외부 링크 필수 (D-050)
  SOLD /// 판매완료 — "떠난 아이템". 도감 소유자 목록에서 제외 (D-023)
}

/// D-103 — 제재 사유. **신고 사유(D-052·D-035)와 같은 축을 쓴다** —
/// 축이 갈리면 신고 처리(A-08) → 제재(A-10) 이동 시 매핑이 안 된다 (FR-05-A-09).
/// 라벨은 3개 언어 i18n 리소스에 있다 — 유저가 자기 언어로 읽어야 하기 때문 (D-066)
enum SanctionReason {
  FAKE /// 위조품
  STOLEN /// 도난품
  WEAPON
  DRUG
  ALCOHOL
  NON_PHYSICAL /// 실물 없는 상품
  PHISHING /// 사기·피싱 링크
  INAPPROPRIATE /// 부적절한 콘텐츠
  WRONG_INFO /// 정보 오류
  REPEATED /// 반복 위반
  OTHER /// 기타 — detail 필수. 이 비율이 높으면 enum 의 의미가 사라진다
}

/// myroom-service §3-5 (D-064)
enum SanctionLevel {
  WARNING /// 경고 — 기능 제한 없음 (FR-07-A-07)
  SUSPENDED /// 일시 정지 — 기간 지정. 만료 시 자동 해제
  BANNED /// 영구 정지 — 어드민 수동 해제
}

/// D-038 — 8종. 매칭 키로 쓸 수 있는 것은 text/number/select/date 4종만 (D-041)
enum AttributeType {
  text
  textarea
  number
  select
  multiselect
  date
  boolean
  url
}

/// codex — 어드민 검증 배지
enum CodexVerification {
  UNVERIFIED
  VERIFIED
}

/// D-029, D-035 — 신고 대상
enum ReportTargetType {
  ITEM
  DIARY
  ROOM
  CODEX
  EXTERNAL_LINK
  /// 착용샷 댓글 (D-179, OI-89 해소)
  COMMENT
}

enum ReportStatus {
  PENDING /// 어드민 큐에 적재. 대상 콘텐츠는 그대로 노출됨
  RESOLVED /// 비공개 처리 등 조치 완료
  REJECTED /// 반려
}

/// D-046 — 유저 브랜드 추가 요청 승인 큐
enum BrandRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// D-026 — 1일 최대 60exp (로그인 10 + 아이템 30 + 일기 20)
enum ExperienceReason {
  LOGIN
  ITEM_CREATE
  DIARY_CREATE
}

// ---------------------------------------------------------------------------
// User / Room / 제재
// ---------------------------------------------------------------------------

/// 인앱 알림 종류 (D-087).
/// **경험치·레벨업은 없다** — 인앱에서만 발생하므로 그 자리에서 보여주면 되고,
/// 알림함에 쌓으면 나머지 4종이 묻힌다 (FR-08-B-05, 원칙 7).
enum NotificationType {
  BRAND_REQUEST_RESULT /// 브랜드 추가 요청 승인·반려 (D-047)
  REPORT_RESULT /// 신고 처리 결과 (market F-05)
  SANCTION /// 제재 부과·해제 (D-066)
  CODEX_MERGED /// 연결된 도감이 병합됨 (codex F-06)
  /// 새 팔로워 (D-178). ⚠️ **기존 4종과 성격이 다르다** — 나머지는 드물게 오는
  /// 처리 결과인데 이건 다른 유저의 행동으로 발생한다. 빈도가 훨씬 높다 (OI-87)
  NEW_FOLLOWER
  /// 내 착용샷에 댓글 (D-178). 위와 같은 성격이다
  WEAR_SHOT_COMMENT
  /// 운동 추가 요청 승인·반려 (D-229, `FR-11-D-06`).
  /// ⚠️ 브랜드 요청(`BRAND_REQUEST_RESULT`)과 **같은 성격**이지만 타입을 나눈다 —
  /// 문구가 다르고("브랜드"/"운동"), 하나로 합치면 params 로 종류를 갈라야 해서
  /// 알림 렌더가 조건 분기를 갖게 된다
  EXERCISE_REQUEST_RESULT
}

/// D-102 — 어드민 계정. **유저와 섞지 않는다.**
///
/// `User.isAdmin` 플래그 방식은 탈락시켰다: 유저 탈퇴(`deletedAt`)와 어드민
/// 권한이 한 행에 얽히고, 유저 조회 쿼리마다 권한 필드가 따라다닌다.
///
/// 로그인은 기존 소셜(D-021)을 그대로 쓰고, **여기에 있고 `active` 인 이메일만**
/// `/admin` 에 접근한다. 계정 추가 화면은 두지 않는다 — 어드민을 추가하는
/// 화면 자체가 권한 상승 경로다.
model AdminUser {
  id     String  @id @default(cuid())
  /// 소셜 계정 이메일. 이것으로 세션과 대조한다
  email  String  @unique
  name   String
  /// 퇴사·권한 회수. 행을 지우지 않는다 — 과거 조치 이력의 참조가 끊긴다
  active Boolean @default(true)

  /// D-104 — **누가 권한을 줬는가.** `AdminUser.id`.
  /// 권한 상승 경로에는 경로 자체의 이력이 필요하다.
  /// 최초 어드민은 시드로 들어오므로 `null` 이다 (화면으로 만들 수 없다)
  invitedBy     String?
  /// 회수도 조치다 (D-104)
  deactivatedBy String?
  deactivatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model User {
  id       String       @id @default(cuid())
  provider AuthProvider
  /// 소셜 provider의 subject
  subject  String
  /// Apple 릴레이 이메일일 수 있다 (FR-05-A-04)
  email    String?

  /// 유저 설정 언어. NEW 피드 언어권 필터의 기준값이다 (D-027, FR-03-B-02)
  language Locale  @default(en)
  /// 경험치 1일 1회 판정 기준 (M-10, D-056). IANA tz name
  /// ⚠️ **null = 아직 수집 안 됨** (D-122). `@default("UTC")` 였을 때는
  /// "수집 안 됨"과 "진짜 UTC 유저"를 구분할 수 없어, 이미 기록됐는지
  /// 판정할 수 없었다 (FR-09-C-04). 읽는 쪽이 `?? "UTC"` 로 떨어진다
  timezone String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// 탈퇴 시각. 방·아이템·일기는 삭제하고 도감은 유지한다 (NFR-User)
  deletedAt DateTime?

  room                Room?
  sanctions           Sanction[]
  experienceLogs      ExperienceLog[]
  blocksMade          Block[]           @relation("blocker")
  blocksReceived      Block[]           @relation("blocked")
  comments            Comment[]
  following           Follow[]          @relation("follower")
  followers           Follow[]          @relation("following")
  reportsMade         Report[]          @relation("reporter")
  brandRequests       BrandRequest[]
  /// D-229 — 마스터에 없는 운동 요청
  exerciseRequests    ExerciseRequest[]
  createdCodex        CodexItem[]       @relation("codexCreator")
  notifications       Notification[]
  /// 선호 카테고리 (D-124). **NEW 피드 첫 진입 기본 필터로만 쓴다** —
  /// 추천 알고리즘에 쓰지 말 것. D-006(전체 노출)을 뒤집는 결정이 된다
  preferredCategories Category[]        @relation("userPreferredCategories")

  /// 관심 언어권 (D-274) — **홈 피드에서 볼 소유자의 설정 언어** 집합.
  ///
  /// ⚠️ `language`(바로 위)와 **다른 것이다.** `language` 는 *내* 화면이 보이는
  /// 말이고, 이것은 *남의* 방을 볼지 말지의 기준이다. 둘을 한 필드로 합치면
  /// 한국어 UI 를 쓰는 사람이 일본 컬렉터를 못 보게 된다.
  ///
  /// ⚠️ **관계가 아니라 스칼라 배열이다.** `Locale` 은 enum 이라 테이블이 없다 —
  /// `preferredCategories` 가 관계인 것은 `Category` 가 테이블이기 때문이다.
  ///
  /// ⚠️ **빈 배열은 "전체"** 다. "아무것도 안 본다" 가 아니다 (D-274)
  preferredLanguages  Locale[]

  /// ⚠️ **봇 계정인가** (D-146). 콘텐츠를 사람이 올린 것으로 오인하지 않기
  /// 위한 표식이다. 원칙 1("소유하는 동안 데이터가 쌓인다")과 마켓 신뢰
  /// 지표(소유 기간)가 봇 콘텐츠로 희석되므로 **구분 가능해야 한다.**
  /// 유저에게 라벨을 노출할지는 별도 결정 (OI-74)
  isBot      Boolean     @default(false)
  botAccount BotAccount?

  @@unique([provider, subject])
  @@index([language])
}

/**
 * 봇 계정 자격증명 (D-146).
 * ## ⚠️ 유저 로그인 경로가 아니다
 * `FR-05-A-02` 는 **이메일/비밀번호 가입을 제공하지 않는다** (D-021). 그래서
 * 비밀번호를 `User` 에 두지 않고 **별도 테이블로 분리**한다 — 유저 인증 코드가
 * 이 컬럼을 볼 일이 없어야 하고, 나중에 누가 "로그인에 쓰자"고 하기 어려워야
 * 한다.
 * 검증은 **로컬 어드민 화면에서만** 일어난다 (D-146).
 */
model BotAccount {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 어드민이 입력하는 로그인 아이디. 이메일이 아니다
  loginId      String @unique
  /// `scrypt` 해시 — `salt:hash` 형식. 평문을 저장하지 않는다
  passwordHash String

  createdAt   DateTime  @default(now())
  lastActedAt DateTime?
}

model Room {
  id     String @id @default(cuid())
  /// M-05 — User당 1개
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// FR-05-A-06 — 유일값이 아니다
  name       String
  bio        String?
  imageUrl   String?
  /// 기본 공개. 방 상태가 아이템 설정을 무시한다 (M-06, FR-02-A-01/04)
  visibility Visibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   Item[]
  diaries Diary[]

  @@index([visibility])
}

/// D-064, D-065 — 제재 이전 방 공개 상태를 함께 보존한다 (M-12)
model Sanction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  level      SanctionLevel
  /// FR-07-A-04 — 필수. 3개 언어 라벨은 i18n 리소스에 있다 (D-103)
  reasonCode SanctionReason
  /// 보조 설명. **`OTHER` 일 때는 사실상 필수**다 — 번역되지 않는 원문이 노출된다
  detail     String?
  /// 일시 정지에만 존재. 만료 시 자동 해제 (FR-07-A-09)
  expiresAt  DateTime?

  /// M-12 — 해제 시 이 값으로 복원한다. 강제 전환값으로 덮어쓰지 않는다
  previousRoomVisibility Visibility?

  /// 조치자 — `AdminUser.id` (D-102). FR-07-A-05 이력 보존의 핵심이다
  issuedBy String
  issuedAt DateTime  @default(now())
  liftedBy String?
  liftedAt DateTime?

  @@index([userId, liftedAt])
  @@index([expiresAt])
}

/// D-051 — A→B 차단 1건이 양쪽 가시성을 차단한다 (M-11, 상호 비가시)
model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String
  blocker   User   @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User   @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// 팔로우 (D-174).
///
/// ## ⚠️ 방이 아니라 **유저** 기준이다
/// 화면에서는 방으로 보이지만(방=유저 1:1) 관계의 주체는 사람이다. 방 기준으로
/// 두면 유저가 방을 지우거나 다시 만드는 경우 관계가 끊어지고, 차단(`Block`)이
/// 유저 기준인 것과 축이 어긋난다.
///
/// ## ⚠️ 일방향이다
/// 맞팔은 두 행이다. 상호 관계를 한 행으로 두면 "A 는 팔로우했지만 B 는 안 했다"를
/// 표현할 수 없다.
/// 착용샷 댓글 (D-178).
///
/// ## ⚠️ 공개 판정을 댓글에 두지 않는다
/// 착용샷이 아이템의 공개 판정을 물려받고(D-148), 댓글은 그 착용샷을 물려받는다.
/// 별도 `visibility` 를 두면 "아이템은 비공개인데 댓글은 공개" 같은 상태가 생기고
/// 그게 곧 유출 경로다.
///
/// ## ⚠️ 대댓글이 없다
/// 계층을 두면 정렬·표시·삭제 규칙이 전부 갈라진다. 착용샷은 "하루 한 장"의 짧은
/// 기록이라(D-148) 스레드가 필요한 분량이 아니다 — 필요해지면 별도 결정.
model Comment {
  id         String   @id @default(cuid())
  wearShotId String
  wearShot   WearShot @relation(fields: [wearShotId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  body String

  createdAt DateTime @default(now())

  /// 목록은 오래된 순 (대화 흐름). 착용샷 단위로 읽는다
  @@index([wearShotId, createdAt])
}

model Follow {
  id          String @id @default(cuid())
  /// 팔로우하는 쪽
  followerId  String
  /// 팔로우당하는 쪽
  followingId String
  follower    User   @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User   @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  /// ⚠️ **중복 팔로우를 DB 가 막는다.** 애플리케이션에서 미리 세는 방식은
  /// 동시 요청에 뚫린다 (D-026 경험치·D-148 착용샷과 같은 구조)
  @@unique([followerId, followingId])
  @@index([followingId])
}

// ---------------------------------------------------------------------------
// Category / 동적 속성 (item-catalog)
// ---------------------------------------------------------------------------

/// D-007 — 6개 고정. 어드민이 신규 생성·삭제하지 않는다 (FR-01-A-02)
/// 카테고리명은 i18n 리소스에서 가져온다 — DB 다국어 컬럼 없음 (policies/i18n §1-1)
model Category {
  id  String @id @default(cuid())
  /// i18n key. messages/*.json의 `category.*`와 일치해야 한다
  key String @unique

  displayOrder Int     @default(0)
  active       Boolean @default(true)

  attributes    CategoryAttribute[]
  codexItems    CodexItem[]
  items         Item[]
  brandScopes   BrandScope[]
  preferredBy   User[]                 @relation("userPreferredCategories")
  matchingKey   MatchingKeyDefinition?
  /// D-207 — 하위 제품군 (캠핑의 텐트·침낭·랜턴). 대부분의 카테고리는 비어 있다
  subtypes      CategorySubtype[]
  /// D-209 — 이 카테고리에서만 보이는 선택지 (시계의 `여분 링크`)
  scopedOptions AttributeOption[]
  /// 이 카테고리 아이템을 **마켓에 올릴 수 있는가** (D-173, OI-85 해소).
  ///
  /// ⚠️ 운동처럼 **소유물이 아닌 카테고리**가 생기면서 필요해졌다 (D-166).
  /// 운동 종목을 판매 전환할 수 있으면 마켓에 "벤치프레스 판매중"이 뜬다.
  ///
  /// 카테고리를 코드에 열거해 예외를 두지 않는다 — 어드민이 카테고리를 늘리면
  /// (A-01) 그때마다 예외 목록을 고쳐야 하고, 빠뜨리면 팔 수 없는 것이 팔린다.
  sellable      Boolean                @default(true)

  /// **사진 1장이 필수인가** (D-224, `FR-07-A-12`).
  ///
  /// ⚠️ **코드에 카테고리를 열거하지 않는다.** D-173 이 `sellable` 을 만들며
  /// "운동만 코드에 예외" 안을 명시적으로 탈락시켰다 — 어드민이 카테고리를
  /// 늘리면 그때마다 예외 목록을 고쳐야 하고, **빠뜨리면 사진 없이 등록되면
  /// 안 되는 것이 등록된다.**
  ///
  /// ⚠️ **기본이 `true`** 라 새 카테고리는 안전한 쪽으로 붙는다. `workout` 만
  /// `false` 이고, 사진이 없으면 **근육맵**이 대표 이미지가 된다 (D-222·D-223).
  ///
  /// ⚠️ **어드민 토글을 만들지 않았다** (`FR-07-A-13`). `sellable` 은 운영
  /// 판단이라 토글이 맞지만 사진 필수는 **카테고리의 성질**이고, 잘못 끄면
  /// **판매 매물에서 사진이 사라져** 거래 신뢰가 무너진다 (원칙 1).
  requiresPhoto Boolean @default(true)

  /// D-231 — **유저 등록이 도감을 만드는가.**
  ///
  /// ## ⚠️ 이 플래그가 매칭 키보다 앞선 판정이다
  /// 운동 도감은 **어드민이 준비한다** (D-227·D-228). 그래서 운동 카테고리의
  /// 매칭 키는 **빈 배열**인데, `codex FR-01-A-03` 은 원래 "매칭 키 최소 1개"를
  /// 강제한다 — 이 플래그가 그 **명시적 예외**다 (`FR-01-A-03b`).
  ///
  /// **빈 배열이 아니라 이 값을 본다.** 빈 배열은 결과이고 플래그가 의도다.
  /// `buildMatchingKey` 가 `null` 을 내는 것에만 의존하면, 나중에 누가 매칭
  /// 키를 채웠을 때 **유저 등록이 조용히 도감을 만든다.**
  ///
  /// ⚠️ 기본이 `true` 라 새 카테고리는 기존 동작으로 붙는다. `workout` 만 `false`.
  userCodexCreation Boolean @default(true)

  /// D-253 — **종류 선택이 필수인가.**
  ///
  /// ## ⚠️ 카테고리를 코드에 열거하지 않는다
  /// `sellable`·`requiresPhoto`·`userCodexCreation` 과 같은 자리다 (D-173·D-231).
  /// `category === "bicycle"` 로 비교하면 두 줄로 끝나지만 **DB 규칙을 코드에
  /// 복제하는 것**이고, 카테고리가 늘 때 고칠 자리가 하나 더 생긴다.
  ///
  /// ## ⚠️ 기본이 `false` 다 — 여기만 다른 셋과 반대다
  /// 나머지 셋은 "안전한 쪽"이 기본이라 `true` 인데, 이것은 **켜는 순간 등록
  /// 단계가 하나 늘어난다.** 종류가 없는 카테고리에 켜지면 유저가 고를 것이
  /// 없는 필수 항목 앞에서 막힌다. 종류를 갖추고 도감을 분류한 뒤에 켠다.
  ///
  /// 지금은 `bicycle` 만 `true` — 캠핑은 도감 208건 분류 후 켠다 (D-257).
  subtypeRequired Boolean @default(false)
}

/// D-207 — **카테고리 하위 제품군.** 캠핑의 텐트·침낭·랜턴처럼
/// **속성 집합이 서로 다른** 제품군을 가른다.
///
/// ## ⚠️ 카테고리를 계층화하지 않고 별도 축으로 둔 이유
/// 카테고리 축은 **IA 의 뼈대**다 — 6개 오픈(D-007) · 필터 축(D-137) · 진열
/// 섹션 · NEW 피드 필터 · sitemap · 브랜드 마스터 연결(D-044). 아이템이 자식
/// 카테고리를 가리키면 **그 전부가 "부모냐 자식이냐"를 다시 판정**해야 한다.
/// subtype 은 **등록 폼과 매칭에만** 영향하는 좁은 축이다.
///
/// 유저는 여전히 "캠핑" 탭에서 텐트·랜턴을 함께 본다 — 방 진열은 카테고리
/// 단위이고 그것이 맞다.
///
/// ## ⚠️ 도감은 subtype 을 갖지 않는다 (D-207 결정 5)
/// 도감 유일성을 subtype 으로 쪼개면 **같은 제품이 subtype 지정에 따라 두
/// 도감으로 갈린다** — 한 유저는 "텐트"로 고르고 다른 유저는 안 고르면
/// `Snow Peak TP-670` 이 둘이 된다. 원칙 4(도감은 연결점)가 무너진다.
///
/// **subtype 은 "무엇을 입력받는가"를 정하지, "무엇이 같은 물건인가"를
/// 정하지 않는다.**
model CategorySubtype {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// 카테고리 안에서 유일. i18n 키가 아니라 여기 라벨을 쓴다 —
  /// 어드민이 런타임에 늘리므로 `messages/*.json` 에 둘 수 없다
  key String

  /// 유저 노출 필드라 3개 언어 필수 (D-010·D-030)
  labelKo String
  labelJa String
  labelEn String

  displayOrder Int     @default(0)
  /// D-036 과 같은 태도 — 삭제가 아니라 비활성화. 값은 보존된다
  active       Boolean @default(true)

  attributes  CategoryAttribute[]
  items       Item[]
  matchingKey MatchingKeyDefinition? @relation("subtypeMatchingKeys")
  /// D-253 — 이 종류에 속한 도감
  codexItems  CodexItem[]            @relation("subtypeCodex")
  matchKeys   CodexMatchKey[]        @relation("subtypeMatchKeys")
  /// D-255 — 이 종류 전용 브랜드 연결
  brandScopes BrandScope[]

  @@unique([categoryId, key])
  @@index([categoryId, active, displayOrder])
}

/// D-010 — 공통 속성 라이브러리. 여러 카테고리가 참조한다 (A-01 규칙)
model AttributeDefinition {
  id   String        @id @default(cuid())
  key  String        @unique
  type AttributeType

  /// 커스텀 속성은 ko/ja/en 3개 필수 (D-010, policies/i18n Case 8)
  labelKo String
  labelJa String
  labelEn String

  /// `number` 타입의 단위. 기호가 같아도 3개 필드를 갖는다 (D-038, FR-02-A-08)
  unitKo String?
  unitJa String?
  unitEn String?

  /// true = 서비스가 사전 번역을 보유한 공통 속성. false = 카테고리 전용 커스텀
  isCommon Boolean @default(false)

  /// 타입별 검증 규칙 (최대 길이 / 소수점 자릿수 / 최소·최대 / 미래 날짜 허용 등)
  /// item-catalog "속성 타입별 검증 규칙" 표 참조
  validation Json?

  categoryAttributes CategoryAttribute[]
  options            AttributeOption[]
}

/// A-02 규칙 — `required`·`active`·`displayOrder`는 카테고리별로 관리한다
/// A-02 규칙 — `required`·`active`·`displayOrder`는 카테고리별로 관리한다.
///
/// ## ⚠️ 카테고리 **또는** 제품군 중 하나에 붙는다 (D-207)
/// `MatchingKeyDefinition` 과 **같은 형태**다. 한 행이 둘 다 가지면
/// `@@unique([categoryId, attributeDefinitionId])` 가 공통 행과 제품군 행을
/// 같은 것으로 보고 막는다 — 캠핑 공통 `brand` 와 텐트 전용 `brand` 를 동시에
/// 둘 수 없게 된다.
///
/// 등록 폼은 **공통(`categoryId`) + 선택된 제품군(`subtypeId`)** 을 합쳐 그린다.
model CategoryAttribute {
  id                    String              @id @default(cuid())
  /// 카테고리 공통. 제품군 전용 행에서는 `null`
  categoryId            String?
  attributeDefinitionId String
  category              Category?           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  /// 제품군 전용(텐트의 수용 인원, 침낭의 내한 온도). 공통 행에서는 `null`.
  /// 고르지 않으면 공통만 나오므로 **기존 6개 카테고리는 지금과 완전히 같다**
  subtypeId String?
  subtype   CategorySubtype? @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  required     Boolean @default(false)
  /// D-036 — 비활성화만. 값은 보존되고 표시에서 제외된다 (M-09)
  active       Boolean @default(true)
  displayOrder Int     @default(0)

  /// 카테고리별 라벨 override (D-168, OI-83 해소).
  ///
  /// ⚠️ 라벨은 `AttributeDefinition` 에 있어 **키 단위 전역**이었다. 그래서 운동
  /// 카테고리의 `model` 이 등록 폼에 **"모델명"** 으로 떴다 — 종목명이어야 한다.
  /// 아이템 명칭이 `Item.model` 컬럼 파생이라(D-073·D-118) 다른 키로 대체할 수도
  /// 없어서, **카테고리마다 다른 이름을 붙일 자리**가 필요했다.
  ///
  /// `null` 이면 `AttributeDefinition` 의 라벨을 쓴다. 3개 언어를 함께 채운다
  /// (D-010 — 하나만 채우면 그 언어 유저만 다른 이름을 본다).
  labelKo String?
  labelJa String?
  labelEn String?

  values ItemAttributeValue[]

  /// 공통 행끼리 유일. 제품군 행은 `categoryId` 가 `null` 이라 걸리지 않는다
  @@unique([categoryId, attributeDefinitionId])
  /// 제품군 행끼리 유일
  @@unique([subtypeId, attributeDefinitionId])
  @@index([categoryId, active, displayOrder])
  @@index([subtypeId, active, displayOrder])
}

/// select / multiselect 선택지. key는 불변이고 라벨만 변경된다 (A-05 규칙)
///
/// ## ⚠️ 선택지는 카테고리마다 다를 수 있다 (D-209)
/// 공통 속성 라이브러리(D-010)의 목적은 **번역 재사용**이다. `포함 부속품`
/// 이라는 **개념은 공통**이 맞다 — 어느 카테고리든 "무엇이 함께 왔는가"가 있다.
/// 그런데 **선택지는 다르다**: 시계의 `여분 링크`(브레이슬릿 링크)가 캠핑 텐트
/// 등록 폼에 떴다.
///
/// **D-168 과 같은 층의 문제다** — 라벨이 `AttributeDefinition` 에 있어 키 단위
/// 전역이라 운동의 `model` 이 "모델명"으로 떴고 `CategoryAttribute` 에 override
/// 를 뒀다. 선택지도 같은 이유로 전역이었다.
model AttributeOption {
  id                    String              @id @default(cuid())
  attributeDefinitionId String
  attributeDefinition   AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  /// D-209 — `null` 이면 **전 카테고리 공통**, 값이 있으면 **그 카테고리에서만**
  /// 노출된다. 커스텀 속성은 애초에 한 카테고리에만 붙으므로 대개 `null` 이다
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  key     String
  /// enum 값도 3개 언어 관리 대상 (policies/i18n §3 — 가장 흔한 누락 지점)
  labelKo String
  labelJa String
  labelEn String

  active       Boolean @default(true)
  displayOrder Int     @default(0)

  @@unique([attributeDefinitionId, key])
}

/// D-043 — 원문 1개 + 언어별 alias. 번역 컬럼을 두지 않는다 (A-04 규칙)
/// 출시 전 시드 290건 + alias 약 900건 필요 (D-044, D-047)
model Brand {
  id      String  @id @default(cuid())
  /// 원문 1개. CSV import는 이 값 기준 upsert — 멱등해야 한다 (FR-04-B-10)
  ///
  /// ⚠️ **표시명이 아니라 식별자다** (D-276). 화면에 무엇을 띄울지는 아래
  /// `nameKo`/`nameJa`/`nameEn` 이 정한다. 이 값을 바꾸면 CSV upsert 멱등성과
  /// `resolveMasterBrand` 매칭이 함께 움직이므로 **표시명 수정으로 건드리지 않는다**
  name    String  @unique
  /// { ko: string[], ja: string[], en: string[] } — **검색 인덱스 전용**, 화면 미표시
  ///
  /// ⚠️ **표시명 3필드가 생겨도 이것은 남는다** (D-276). alias 에는 3필드로
  /// 담기지 않는 **약어·이표기**가 89건 들어 있다 — `gs`→Grand Seiko,
  /// `ap`→Audemars Piguet, `jlc`→Jaeger-LeCoultre. 지우면 그 검색어가 죽는다
  aliases Json    @default("{}")

  /// 표시용 언어별 명칭 (D-276). **검색이 아니라 화면에 띄우는 값**이다.
  ///
  /// ⚠️ `aliases` 와 역할이 다르다: alias 는 **정규화된 검색 토큰**이라
  /// `G-SHOCK` 의 en alias 가 `gshock` 이다 — 그대로 띄우면 이름이 깨진다.
  ///
  /// ⚠️ **nullable 이다.** 비면 `name`(원문)으로 떨어진다 — D-046 브랜드 요청
  /// 승인처럼 3개 언어를 당장 채울 수 없는 경로가 있고, 거기서 막히면
  /// 브랜드가 아예 안 만들어진다. 빈 이름을 띄우는 것보다 원문이 낫다
  nameKo  String?
  nameJa  String?
  nameEn  String?

  /// 노출 우선순위 — **높을수록 앞** (D-285). 같은 값이면 명칭 사전순.
  ///
  /// ⚠️ **방향이 "높을수록 앞" 인 것이 의도다.** 초판은 "낮을수록 앞" 이었는데
  /// 기본값 0 이 **가장 작아서 맨 앞**에 왔다 — 우선순위가 정반대로 동작했다
  /// (실측으로 확인). `NULLS LAST` 는 NULL 에만 듣고 0 에는 안 듣는다.
  /// 방향을 뒤집으면 **0 = 지정 안 됨이 자연히 맨 뒤**가 되어 함정이 사라진다.
  ///
  /// | 값 | 뜻 |
  /// |---|---|
  /// | `100` | 카테고리 대표 — 목록 맨 위 |
  /// | `50` | 널리 알려진 이름 |
  /// | `0` | 지정 안 됨 (기본) — 명칭 사전순으로 뒤에 |
  ///
  /// ⚠️ **검색 랭킹을 이기지 않는다.** `gs` 를 쳤을 때 alias 가 정확히 `gs` 인
  /// `Grand Seiko` 가 먼저 와야 한다 (OI-54) — 우선순위는 **같은 랭크 안의
  /// 동점을 가르는 값**이지 정확도를 뒤집는 값이 아니다.
  ///
  /// ⚠️ 카테고리별이 아니라 **전역**이다. 브랜드는 이미 카테고리로 걸러진 뒤
  /// 정렬되므로(`BrandScope`) 전역 값 하나로 충분하다 — `Shimano` 는 자전거
  /// 목록에만 나타난다.
  displayOrder Int @default(0)

  active  Boolean @default(true)

  /// D-255 — 카테고리 **또는 그 하위 종류**에 연결된다 (종전 Category N:M).
  ///
  /// ⚠️ **포함적 scope 다** — 카테고리 행(`subtypeId` null)은 그 카테고리 전
  /// 종류에 공통으로 보이고, 종류 행은 그 종류에만 더해진다. 도감(배타)과
  /// 반대 방향이다: 선택지 목록이라 좁히면 유저가 막힌다
  scopes BrandScope[]
  items  Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// D-046 — 유저 요청 + 어드민 승인 큐 (A-12). 즉시 반영하지 않는다
/// D-255 — 브랜드가 **어느 단위에 붙는가**. 종전 암묵 조인 `_BrandToCategory` 를 대체한다.
///
/// ## ⚠️ 포함적 scope 다 — 도감과 반대다
/// `subtypeId` 가 `null` 이면 **그 카테고리 전 종류 공통**, 값이 있으면 **그 종류에만**
/// 더해진다. 등록 폼의 브랜드 목록은 **둘의 합집합**이다.
///
/// 도감이 배타적(정확히 한 scope)인 것과 방향이 반대인 이유는, 하나는 **유일성
/// 판정**이고 하나는 **선택지 목록**이기 때문이다. 선택지를 좁히면 유저가 막힌다.
///
/// `CategoryAttribute`(공통 + 종류 전용 합집합)·`AttributeOption`(D-209)과 같은 패턴이다.
model BrandScope {
  id      String @id @default(cuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// `null` = 이 카테고리 전 종류 공통
  subtypeId String?
  subtype   CategorySubtype? @relation(fields: [subtypeId], references: [id], onDelete: Cascade)

  /// D-254 — GENERATED: `COALESCE("subtypeId", "categoryId")`
  scopeId String @default(dbgenerated())

  @@unique([brandId, scopeId])
  @@index([scopeId])
  @@index([categoryId])
}

model BrandRequest {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  requestedName String
  /// 어떤 카테고리에서 요청됐는지. 승인 시 브랜드-카테고리 연결에 쓴다
  categoryKey   String

  status     BrandRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  /// 거부 사유 또는 기존 브랜드 alias로 흡수한 경우의 메모
  note       String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// 도감 (codex)
// ---------------------------------------------------------------------------

/// D-013 — 카테고리마다 매칭 키가 다르다 (단일 / 복합). A-03
/// A-03 매칭 키 정의 (D-013).
///
/// ## ⚠️ 카테고리 **또는** 제품군 중 하나에 붙는다 (D-207)
/// 두 소유자를 각각 `@unique` nullable 로 둔다 — Postgres 는 `null` 을 서로 다른
/// 값으로 보므로 "카테고리당 1개 · 제품군당 1개"가 DB 제약으로 걸린다.
///
/// **1-1 관계를 유지한 것이 의도다.** 카테고리를 1-N 으로 바꾸면
/// `category.matchingKey?.attributeKeys` 를 읽는 **10곳이 전부** 바뀐다.
/// 텐트는 제조사 품번, 소품은 `brand+model` 처럼 제품군마다 다를 수 있고
/// 그것이 D-195 가 캠핑에서 `[검증 필요]` 로 남긴 문제의 해소 경로다.
///
/// ⚠️ **도감 유일성은 여전히 카테고리 단위다** (D-207 결정 5). 매칭 키가
/// 갈려도 같은 제품이 두 도감이 되면 안 된다.
model MatchingKeyDefinition {
  id         String    @id @default(cuid())
  /// 카테고리 기본값. 제품군 전용 행에서는 `null`
  categoryId String?   @unique
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// 제품군 전용. 카테고리 기본 행에서는 `null`
  subtypeId String?          @unique
  subtype   CategorySubtype? @relation("subtypeMatchingKeys", fields: [subtypeId], references: [id], onDelete: Cascade)

  /// AttributeDefinition.key 배열. 순서가 정규화 키 생성 순서다 (FR-01-A-05)
  /// 최소 1개 (FR-01-A-03). text/number/select/date 타입만 (FR-01-A-06)
  attributeKeys String[]

  updatedAt  DateTime               @updatedAt
  /// 변경 이력 (FR-01-B-04)
  changeLogs MatchingKeyChangeLog[]
}

model MatchingKeyChangeLog {
  id                      String                @id @default(cuid())
  matchingKeyDefinitionId String
  matchingKeyDefinition   MatchingKeyDefinition @relation(fields: [matchingKeyDefinitionId], references: [id], onDelete: Cascade)

  before    String[]
  after     String[]
  changedBy String
  changedAt DateTime @default(now())
}

model CodexItem {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /// D-009 — 원문 명칭. **식별용 기준값이고 항상 채워져 있다.**
  ///
  /// ⚠️ D-276 이 아래 `nameKo`/`nameJa`/`nameEn` 을 더했지만 **이 필드가
  /// 없어지는 것이 아니다.** 도감은 유저 등록으로 자동 생성되므로(D-005)
  /// 3개 언어를 요구할 수 없다 — 그것이 D-009 선택지 B 가 탈락한 이유다.
  /// 언어별 명칭이 비면 **이 값으로 떨어진다**
  displayName   String

  /// 표시용 언어별 명칭 (D-276). **비어 있는 것이 정상이다** — 채워진 것만 쓴다.
  ///
  /// ⚠️ `aliases`(검색 전용)와 역할이 다르다. 운동 도감처럼 어드민이 만든
  /// 것에는 표시 품질의 영문명이 있지만, 유저가 만든 도감에는 없다
  nameKo        String?
  nameJa        String?
  nameEn        String?

  /// 노출 우선순위 — **높을수록 앞** (D-285). `Brand.displayOrder` 를 복사한 값이다.
  ///
  /// ⚠️ **도감에는 브랜드 링크가 없다.** 매칭 키 첫 세그먼트로 브랜드를 찾아
  /// 스크립트가 채운다(`prisma/apply-brand-priority.ts`) — 조회 때마다 조인할
  /// 수 없어 값을 복사해 둔다.
  ///
  /// ⚠️ **복사본이라 갱신이 필요하다.** 브랜드 우선순위를 바꾸면 스크립트를
  /// 다시 돌려야 도감에 반영된다. 안 돌려도 **정렬만 옛 값일 뿐** 기능은
  /// 멀쩡하다 — 그래서 실시간 동기화를 만들지 않았다
  displayOrder  Int @default(0)
  /// 매칭 키가 단일 키인 카테고리의 고유값 (레퍼런스넘버·스타일코드 등)
  uniqueId      String?
  /// D-014 — 매칭 키를 정규화해 만든 키. **스코프 단위** 유일 (D-254)
  normalizedKey String

  /// D-253 — 종류가 있는 카테고리면 채운다. 유일성은 이 축으로 갈린다
  subtypeId String?
  subtype   CategorySubtype? @relation("subtypeCodex", fields: [subtypeId], references: [id], onDelete: Restrict)

  /// D-254 — **DB 가 계산한다**: `COALESCE("subtypeId", "categoryId")`.
  ///
  /// ⚠️ 그냥 `@@unique([categoryId, subtypeId, normalizedKey])` 로 두면
  /// **`subtypeId` 가 NULL 일 때 중복이 통과한다** — Postgres 에서 NULL 은
  /// 서로 다른 값이라 유니크에 걸리지 않는다. 생성 컬럼은 절대 NULL 이 아니다.
  ///
  /// 앱은 이 값을 쓰지 않는다. 읽기·필터 전용
  scopeId String @default(dbgenerated())

  /// { ko: string[], ja: string[], en: string[] } — 검색 전용 (D-009)
  aliases Json @default("{}")

  /// 미검증 설명은 유저 입력 유래 → 원문 그대로 (policies/i18n §1-3)
  description  String?
  /// 검증된 도감의 어드민 작성 설명. { ko?, ja?, en? } — 미입력 언어는 fallback
  descriptions Json?

  verification CodexVerification @default(UNVERIFIED)
  verifiedBy   String?
  verifiedAt   DateTime?

  /// M-02 — 연결된 Item이 0건이어도 존재한다 (어드민 직접 등록)
  createdByUserId String?
  createdByUser   User?   @relation("codexCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  /// D-016 — 병합으로 흡수된 경우 살아남은 도감을 가리킨다. 되돌리기 가능해야 한다
  /// 병합 때 **이 도감에서 survivor 로 옮긴 아이템 id 목록** (D-181, OI-62).
  ///
  /// ⚠️ 이것이 없으면 **되돌리기가 절반만 된다** — `mergedIntoId` 만 끊으면 도감은
  /// 살아나지만 아이템은 survivor 에 남는다. `updateMany` 로 이관하면 원래
  /// `codexItemId` 가 사라지므로 **이관 전에 기록해야** 한다.
  ///
  /// 되돌린 뒤에는 비운다 — 남겨두면 두 번 되돌릴 수 있다.
  mergedItemIds Json?
  mergedIntoId  String?
  mergedInto    CodexItem?  @relation("codexMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom    CodexItem[] @relation("codexMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items Item[]

  /// D-197 — 정식 값(PRIMARY) + 키 alias(ALIAS)
  matchKeys        CodexMatchKey[]
  /// D-196 — 이 도감이 survivor 였던 병합들
  mergesAsSurvivor CodexMerge[]    @relation("mergeSurvivor")

  /// D-228 — **운동 카테고리 전용 부속.** 카테고리 `workout` 이면 반드시 있고
  /// 나머지 카테고리는 항상 `null` 이다 (`FR-11-A-04` — 한 트랜잭션으로 만든다)
  exercise Exercise?

  /// D-254 — normalizedKey 는 **스코프** 단위 유일 (종전 categoryId 단위)
  @@unique([scopeId, normalizedKey])
  @@index([subtypeId])
  @@index([verification])
  @@index([uniqueId])
}

/// D-192 — 정식 값이냐 동의어냐
enum MatchKeyKind {
  PRIMARY
  ALIAS
}

/// D-194 — 어디서 들어왔는가. FR-05-C-05·C-06 이 이 값으로 갈린다
enum MatchKeySource {
  /// CodexItem.normalizedKey 의 미러 (백필·삽입 규칙이 만든다)
  SYSTEM
  /// FR-05-B-09 — 병합이 흡수 도감의 정식 값을 넘겨준 것
  MERGE
  /// 어드민 수동 (A-07)
  ADMIN
  /// AI 조사 제안 중 어드민이 승인한 것 (FR-06-C-05)
  AI_APPROVED
}

/// D-197 — 매칭 인덱스. **정식 값과 키 alias 를 한 테이블에 둔다.**
///
/// ⚠️ **나누면 유일성을 걸 수 없다.** FR-02-B-06 의 유일성 범위는
/// `normalizedKey` ∪ 키 alias 인데 DB 제약은 한 테이블 안에서만 걸린다.
/// 애플리케이션에서 미리 세는 방식은 경합에 뚫린다 — FR-03-B-05 가 이미
/// 같은 이유로 유니크 제약에 의존한다.
///
/// ⚠️ **`CodexItem.normalizedKey` 를 대체하지 않는다.** 무엇이 정식 값인지가
/// D-186 가드(슬러그 차단)와 D-195(정식 값 정의)의 판정 기준이다. PRIMARY 행은
/// 그 미러이고 삽입 규칙 한 곳(`lib/codex-insert.ts`)에서만 함께 쓴다.
model CodexMatchKey {
  id String @id @default(cuid())

  /// CodexItem.categoryId 의 사본
  categoryId  String
  /// D-253 — CodexItem.subtypeId 의 사본. 도감과 **항상 같아야 한다**
  subtypeId   String?
  subtype     CategorySubtype? @relation("subtypeMatchKeys", fields: [subtypeId], references: [id], onDelete: Restrict)
  /// D-254 — GENERATED: `COALESCE("subtypeId", "categoryId")`. 유일 제약이 이 컬럼을 쓴다
  scopeId     String           @default(dbgenerated())
  codexItemId String
  codexItem   CodexItem        @relation(fields: [codexItemId], references: [id], onDelete: Cascade)

  /// D-014 정규화를 거친 값. 복합 키는 `|` 로 결합된 전체다 (E-02-09)
  value String
  kind  MatchKeyKind

  source MatchKeySource

  /// D-196 — FR-05-C-05 가 이 FK 하나로 걷어낸다.
  /// 어드민이 손대면 source 가 ADMIN 으로 바뀌어 삭제 대상에서 빠진다 (E-05-10)
  sourceMergeId String?
  sourceMerge   CodexMerge? @relation(fields: [sourceMergeId], references: [id], onDelete: SetNull)

  /// FR-06-C-05 — AI 제안은 이 값이 있어야 매칭에 쓰인다.
  /// PRIMARY 와 MERGE 는 승인 개념이 없으므로 null 이어도 매칭된다
  approvedBy String?

  createdAt DateTime @default(now())

  /// ⚠️ FR-02-B-06 — 정식 값과 키 alias 를 합친 전체 집합의 유일성.
  /// D-254 — 범위가 카테고리에서 **스코프**로 좁아졌다
  @@unique([scopeId, value])
  @@index([subtypeId])
  @@index([codexItemId])
  @@index([sourceMergeId])
}

/// D-196 — **병합 1회 = 1행.**
///
/// ⚠️ 이것이 없어서 OI-93 이 막혀 있었다. 병합 상태가 `CodexItem` 행에 흩어져
/// 있어(`mergedIntoId`·`mergedItemIds`) 한 번의 병합이 N 개 행에 나뉘고,
/// **"이 alias 는 그 병합에서 왔다"고 쓸 id 가 존재하지 않았다.**
///
/// ⚠️ FR-05-C-01 의 **실행자·일시가 지금까지 어디에도 없었다.**
/// `MatchingKeyChangeLog` 는 changedBy/changedAt 를 갖는데 병합만 없었다.
model CodexMerge {
  id         String @id @default(cuid())
  categoryId String

  survivorId String
  survivor   CodexItem @relation("mergeSurvivor", fields: [survivorId], references: [id], onDelete: Cascade)

  /// `[{ codexItemId, movedItemIds: string[] }]` — 흡수 도감과 각각이 내보낸 아이템
  absorbed Json

  /// FR-05-C-01
  mergedBy String
  mergedAt DateTime @default(now())

  /// FR-05-C-07 — ⚠️ 되돌려도 행을 지우지 않는다.
  /// 두 번 되돌리기 방지는 이 값이 한다 (CodexItem.mergedItemIds 를 비울 필요가 없어졌다)
  revertedBy String?
  revertedAt DateTime?

  keyAliases CodexMatchKey[]

  @@index([survivorId])
  @@index([categoryId, mergedAt])
}

/// D-198 — 매칭 결과
enum MatchOutcome {
  /// 정식 값 일치
  EXACT
  /// 키 alias 일치 (FR-03-E-01)
  KEY_ALIAS
  /// 미스 → 미검증 도감 자동 생성 (FR-03-B-01)
  CREATED
}

/// D-198 — 매칭 계측. **H11 판별자이자 키 alias 후보 큐(FR-06-C-09)다.**
///
/// ⚠️ `outcome` 만 세면 미스 원인이 **단위 차이**인지 **도감 부재**인지 모른다.
/// 검색은 부분일치이므로(FR-06-B-01) **같은 값으로 검색하면 나오는데 등록은
/// 미스** = 단위 차이(OI-97 유형)다. CREATED 일 때만 검색을 한 번 돌아 남긴다.
///
/// ⚠️ **userId·itemId 를 넣지 않는다** (FR-03-E-09). 집계가 목적이고 후보 큐에는
/// topHitCodexId 면 충분하다 — 용도가 없는 수집은 하지 않는다.
model CodexMatchLog {
  id String @id @default(cuid())

  categoryId String
  /// 복합 키 카테고리의 미스 분포를 브랜드별로 본다. FK 를 걸지 않는다(로그)
  brandId    String?

  /// 정규화된 시도값
  attempted String
  outcome   MatchOutcome

  /// ⚠️ CREATED 일 때만 채운다 — H11 판별자
  searchHits    Int?
  /// 1순위 후보 = 키 alias 후보. 삭제된 도감을 가리킬 수 있어 FK 를 걸지 않는다
  topHitCodexId String?

  createdAt DateTime @default(now())

  @@index([categoryId, outcome, createdAt])
  @@index([categoryId, attempted])
}

// ---------------------------------------------------------------------------
// Item (item-catalog) / 판매 (market)
// ---------------------------------------------------------------------------

/// M-14 — 아이템 명칭은 저장하지 않는 파생값이다.
///   도감 연결 시 CodexItem.displayName, 미연결 시 brand.name + model (D-073)
/// D-228 — **운동 마스터의 부속 테이블.** `CodexItem`(카테고리 `workout`) 1:1.
///
/// ## ⚠️ 운동은 아이템이 아니다 (D-227)
/// 운동 카테고리의 `Item` 은 **루틴**뿐이다. 벤치프레스라는 **종목 그 자체**는
/// 유저 소유물이 아니라 **어드민이 준비한 사실**이므로 여기 산다.
///
/// ## ⚠️ 왜 독립 테이블이 아니라 `CodexItem` 의 부속인가
/// 독립으로 만들면 `verification`·`aliases`·`mergedInto`·`normalizedKey` 를
/// **다시 만들어야** 하고, A-05 검수·A-07 alias·도감 병합 화면이 **운동만 따로**
/// 필요해진다. **같은 것을 두 경로로 계산하면 갈린다** (D-190·D-197·D-202·D-218).
/// 운동명·설명·alias·검수는 `CodexItem` 에 있고 여기 **중복 정의하지 않는다.**
///
/// ## ⚠️ 선택지 값은 `AttributeOption.key` 다 — enum 이 아니다
/// 3개 언어 라벨 · `displayOrder`(근육맵 표시 순서, `FR-10-D-03`) · 카테고리
/// 스코프(D-209)가 이미 `AttributeOption` 에 걸려 있다. enum 으로 옮기면 그 셋을
/// 코드와 메시지 파일로 흩어야 한다 (D-227).
model Exercise {
  id String @id @default(cuid())

  /// 1:1 — 이 운동의 도감. 운동명·설명·alias·검수 상태가 여기 있다
  codexItemId String    @unique
  codexItem   CodexItem @relation(fields: [codexItemId], references: [id], onDelete: Cascade)

  /// 자극부위 (다중). `AttributeOption.key` 값 — `chest`·`triceps` …
  /// ⚠️ **근육맵이 이 값으로 칠한다.** 목록에 없는 값이 들어오면 조용히 안 칠해진다
  targetMuscles String[]

  /// 장비 (`barbell`·`dumbbell`·`machine` …) — `AttributeOption.key`
  equipmentType String?
  /// 복합/단일 (`compound`·`isolation`)
  mechanic      String?
  /// 밀기/당기기/정적 (`push`·`pull`·`static`)
  forceType     String?

  /// 폼 시연 영상. 외부 링크 경고를 거친다 (D-040)
  referenceUrl String?

  /// D-036 의 태도 — 사용 중이면 삭제하지 않고 비활성화한다.
  /// ⚠️ **비활성화해도 이미 담긴 루틴에서는 사라지지 않는다** (`FR-10-B-08`) —
  /// 유저가 만든 순서가 깨지기 때문이다. 검색 결과에서만 빠진다
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 이 운동을 담은 루틴 항목들 (내 설정이 각 행에 실린다)
  entries RoutineEntry[]

  @@index([active])
}

/// D-229 — **마스터에 없는 운동 요청.** `BrandRequest`(D-046)와 같은 모양이다.
///
/// ⚠️ **즉시 반영하지 않는다.** 즉시 반영하면 도감이 다시 유저 입력이 되고
/// D-228 이 막은 유저 생성 경로가 되살아난다.
///
/// ⚠️ **반려로 끝내면 같은 요청이 다시 온다** (`FR-11-D-07`). 이미 있는 운동을
/// 다른 이름으로 요청한 경우 그 이름을 **alias 로 흡수**해야 검색이 잡는다.
model ExerciseRequest {
  id          String @id @default(cuid())
  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  /// 유저가 적은 운동명 원문
  requestedName  String
  /// D-014 정규화 값 — 같은 요청을 **묶어 세는** 기준 (`FR-11-D-05`)
  normalizedName String

  status     BrandRequestStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  note       String?

  /// 승인으로 만들어진(또는 반려에서 지정된) 운동. 알림·추적용
  resolvedExerciseId String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([normalizedName])
}

model Item {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  /**
   * D-211 — **구성 관계.** 자전거의 프레임·구동계·휠셋처럼 **한 물건이 부품으로
   * 조립되는** 카테고리를 위한 것이다.
   * ## ⚠️ 부품도 아이템이다 — 하위 카테고리가 아니다
   * 부품은 각자 **제품 원형(도감)이 있고 교체된다.** 하위 카테고리로 만들면
   * "내 자전거 1대"가 방에서 5칸으로 흩어져 원칙 2 가 깨진다 (D-206).
   * *부품 도감이 완성차 도감보다 연결점으로 강하다** — `Madone SLR 9 / 2023`
   * 소유자는 소수지만 `Ultegra R8100` 은 매우 많다 (원칙 4).
   * ## ⚠️ 자식은 진열·피드·마켓·사이트맵에서 빠진다
   * 전시 단위는 **부모**다. 조회 경로마다 `parentId: null` 을 걸어야 하고,
   * 한 곳이라도 빠지면 그 화면에만 샌다 (D-096·D-099 와 같은 유형).
   * ## ⚠️ 부모를 지우면 자식은 독립 승격된다 (`SetNull`)
   * 같이 지우면 데이터가 유실된다 — 자전거를 팔아도 떼어낸 부품은 남길 수
   * 있어야 한다 (D-023·D-036 과 같은 태도).
   */
  parentId String?
  parent   Item?   @relation("itemParts", fields: [parentId], references: [id], onDelete: SetNull)
  parts    Item[]  @relation("itemParts")

  /// D-207 — 하위 제품군(캠핑의 텐트·랜턴). **선택이다.**
  /// `null` 이면 카테고리 공통 속성만 쓰며 기존 6개 카테고리는 전부 그렇다 —
  /// 그래서 이 필드가 생겨도 **기존 데이터 마이그레이션이 없다**
  subtypeId String?
  subtype   CategorySubtype? @relation(fields: [subtypeId], references: [id], onDelete: SetNull)

  /// M-08 — 자유 텍스트가 아니다 (D-043). 브랜드 요청 대기 중이면 null (D-046)
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)
  /// 자유 텍스트. 도감이 갈라지는 잔여 리스크는 item-catalog R3로 수용됨
  model   String?


  /// M-01 — CodexItem 없이도 존재할 수 있다 (도감 미연결 등록, D-032)
  codexItemId String?
  codexItem   CodexItem? @relation(fields: [codexItemId], references: [id], onDelete: SetNull)

  visibility Visibility     @default(PUBLIC)
  saleStatus ItemSaleStatus @default(DISPLAYED)

  /// 판매 전환 시 가격·통화·외부 링크 3개 필수 (D-050).
  /// 판매 취소 후에도 값은 보존된다 (market §2) — 방 공개 복귀 시 재입력 요구 금지 (FR-02-A-08)
  price       Decimal?  @db.Decimal(14, 2)
  currency    Currency?
  externalUrl String?
  /// 판매 전환 시각 — 마켓 기본 정렬 기준 (D-048, market FR-02-A-03).
  /// ⚠️ createdAt·updatedAt 로 대신할 수 없다: createdAt 은 등록 시각이라
  /// 오래된 물건을 지금 올려도 뒤로 가고, updatedAt 은 사진만 고쳐도 앞으로 온다
  onSaleAt    DateTime?
  soldAt      DateTime?

  /// FR-03-A-01/09 — NEW 피드 정렬 기준. 비공개→공개 전환으로 갱신하지 않는다 (D-070)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos          ItemPhoto[]
  attributeValues ItemAttributeValue[]
  diaries         DiaryItem[]
  /// D-236 — **이 아이템이 루틴일 때** 담고 있는 항목들 (운동 또는 휴식).
  /// ⚠️ D-221 의 `routineMemberships`(종목으로서 속한 루틴)는 **없어졌다** —
  /// 운동이 아이템이 아니므로 아이템이 루틴에 속하는 일 자체가 없다
  routineEntries  RoutineEntry[]
  /// 착용샷 (D-148) — 아이템 종속 1:N. 일기(N:M, D-054)와 다른 층이다
  wearShots       WearShot[]

  @@index([visibility, saleStatus, createdAt])
  /// 마켓 기본 정렬 (D-048) — 판매중만 훑는다
  @@index([saleStatus, onSaleAt])
  @@index([roomId, categoryId])
  @@index([codexItemId])
}

/// D-037 — 최대 10장, 1장 이상 필수 (M-07). 첫 장이 대표 이미지
model ItemPhoto {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  url          String
  displayOrder Int    @default(0)

  @@index([itemId, displayOrder])
}

/// M-09 / A-03 규칙 — 비활성 속성의 값도 보존된다 (D-036)
model ItemAttributeValue {
  id                  String            @id @default(cuid())
  itemId              String
  categoryAttributeId String
  item                Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoryAttribute   CategoryAttribute @relation(fields: [categoryAttributeId], references: [id], onDelete: Restrict)

  /// 타입별 값. 속성 값은 번역 대상이 아니다 — 원문 그대로 (policies/i18n §1-2)
  /// text/textarea/url/date/select → string, number → string(정밀도 보존),
  /// boolean → bool, multiselect → string[]
  value Json

  @@unique([itemId, categoryAttributeId])
  @@index([categoryAttributeId])
}

// ---------------------------------------------------------------------------
// 일기 (diary)
// ---------------------------------------------------------------------------

model Diary {
  id     String @id @default(cuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// D-053 — 언어 무관 1000자. 플레인 텍스트, URL 자동 링크화 없음
  body       String
  visibility Visibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos DiaryPhoto[]
  items  DiaryItem[]

  @@index([roomId, visibility, createdAt])
}

/// 사진 최대 10장. 아이템과 정책 공유 (D-037)
model DiaryPhoto {
  id      String @id @default(cuid())
  diaryId String
  diary   Diary  @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  url          String
  displayOrder Int    @default(0)

  @@index([diaryId, displayOrder])
}

/// M-03 — Diary↔Item은 N:M (D-054).
/// 아이템 삭제 시 일기는 남고 연결만 해제된다 — Cascade는 이 join row에만 적용된다
model DiaryItem {
  diaryId String
  itemId  String
  diary   Diary  @relation(fields: [diaryId], references: [id], onDelete: Cascade)
  item    Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([diaryId, itemId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// 경험치 · 레벨 (leveling)
// ---------------------------------------------------------------------------

/// A-09 — 어드민이 관리하는 레벨 테이블. 10레벨 (D-026)
model LevelDefinition {
  level       Int @id
  requiredExp Int

  updatedAt DateTime @updatedAt
}

/// D-026 — 같은 행동은 1일 1회. D-056 — "오늘"의 경계는 유저 타임존 기준
/// D-058 — 회수 없음. 레벨은 단조 증가
model ExperienceLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reason ExperienceReason
  amount Int

  /// 유저 타임존 기준 날짜 (YYYY-MM-DD). 1일 1회 판정의 유일 제약 근거 (D-056)
  /// 운영 지표는 createdAt(UTC)을 쓴다 — 두 기준이 공존한다
  localDate String

  createdAt DateTime @default(now())

  /// FR-01-A-04 — 같은 행동을 같은 날 반복해도 추가 부여 없음
  @@unique([userId, reason, localDate])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// 신고 (market)
// ---------------------------------------------------------------------------

/// D-029, D-035 — 대상은 아이템·일기·방·도감·외부 링크. A-08
model Report {
  id         String @id @default(cuid())
  reporterId String
  reporter   User   @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  targetType ReportTargetType
  /// 대상 엔티티 id. 대상 종류가 5가지라 FK로 묶지 않는다
  targetId   String

  reason String
  detail String?

  status     ReportStatus @default(PENDING)
  handledBy  String?
  handledAt  DateTime?
  /// 조치 내용 (비공개 처리 / 반려 사유)
  resolution String?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/// 인앱 알림 (S-22, D-087).
///
/// ⚠️ **푸시가 없으므로(D-059) 이것이 유일한 전달 경로다.** 위 4종은 유저가
/// 서비스에 없을 때 발생한다. 특히 제재 통지가 전달되지 않으면
/// D-066("제재 시 로그인을 막지 않는다")의 근거가 무너진다.
///
/// 알림별 on/off 설정은 두지 않는다 (FR-08-A-08) — 4종 전부 받아야 하는
/// 것이라 끄면 제재 통지를 놓친다.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  /// 이동 대상 엔티티 id. 종류가 여러 가지라 FK로 묶지 않는다 (Report 와 같은 이유)
  targetId String?

  /// 문구 치환값. 본문은 3개 언어 i18n 리소스로 만든다 (FR-08-A-09) —
  /// 서버에 완성된 문장을 저장하면 유저가 언어를 바꿔도 옛 언어로 남는다
  params Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  /// 목록은 최신순 (FR-08-A-04). 미읽음 뱃지 판정도 이 인덱스를 쓴다
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/**
 * 착용샷 — "오늘 이거 썼다" (D-148).
 * ## ⚠️ 일기와 다른 층이다
 * | | 일기 (D-054) | 착용샷 |
 * |---|---|---|
 * | 아이템 | **N:M** — 여러 아이템, 연결은 선택 | **1:N** — 아이템 하나에 종속 |
 * | 본문 | 1000자 | **짧은 노트 1개** |
 * | 사진 | 최대 10장, **선택** | **1장 필수** |
 * | 성격 | **사건** 기록 ("이번 캠핑에…") | **하루** 기록 ("오늘 이거 찼다") |
 * D-054 가 1:N 을 탈락시킨 이유는 "일기가 아이템 설명과 구분되지 않는다" 였다.
 * 착용샷은 **애초에 아이템에 붙는 기록**이므로 그 문제가 없다.
 * ## ⚠️ 아이템당 하루 1장 (D-148)
 * `@@unique([itemId, wornOn])` 이 **유일한 보장**이다. 애플리케이션에서
 * "오늘 있나"를 세는 방식은 동시 요청에 뚫린다 — `ExperienceLog` 와 같은 구조다.
 * `wornOn` 은 **유저 타임존 기준 날짜 문자열**(`YYYY-MM-DD`)이다 (D-056).
 * `DateTime` 으로 두면 자정 근처에서 UTC 로 하루가 갈린다.
 */
model WearShot {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// 1장 필수 — 착용샷의 본질이다
  photoUrl String
  /// 짧은 한 도마리. 비어 있을 수 있다 (사진만으로 성립)
  note     String?

  /// ⚠️ 유저 타임존 기준 `YYYY-MM-DD` (D-056). `DateTime` 금지
  wornOn String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  comments  Comment[]

  /// 아이템당 하루 1장 — 위 주석 참조
  @@unique([itemId, wornOn])
  /// 목록은 최신순 (S-25)
  @@index([itemId, wornOn])
}

/// 루틴 ← 종목 (D-221). **운동 루틴의 구성 관계**다.
///
/// ## ⚠️ 왜 `Item.parentId`(D-211)를 쓰지 않는가
/// 자전거 부품은 **한 자전거에만** 붙지만 **한 종목은 여러 루틴에 들어간다**
/// — `벤치프레스` 가 A 루틴에도 B 루틴에도 있는 것이 정상이다. `parentId` 는
/// 1:N 이라 이것을 담을 수 없다.
///
/// 그리고 **루틴은 순서가 곧 내용**이다(1번 벤치 → 2번 인클라인). 부품에는
/// 없던 축이라 `parentId` 로는 표현할 자리조차 없다.
///
/// ## ⚠️ 종목 카드는 하나다 (D-221 Q4)
/// 세트·횟수·중량은 **종목 아이템의 속성**이므로 두 루틴이 공유한다. 중량을
/// 올리면 양쪽에 반영된다 — 값이 한 곳에만 있어 갈릴 여지가 없다.
///
/// ## ⚠️ `Cascade` 는 관계만 지운다
/// 루틴을 삭제하면 이 행만 사라지고 **종목 아이템은 남아 진열로 돌아온다**
/// (`FR-10-B-06·07`). D-211 Q5(부모 삭제 시 자식 독립 승격)가 여기서는
/// 자동으로 성립한다.
/// 루틴 항목 종류 (D-236).
///
/// ⚠️ **휴식이 항목이 된 이유** — 실제 훈련에서 "운동 사이 3분"은 운동의 속성이
/// 아니라 **순서상의 한 칸**이다. 운동 안에 넣으면 "어느 운동의 뒤쪽 휴식인가"가
/// 모호해지고, 마지막 운동에는 뒤가 없다.
enum RoutineEntryKind {
  EXERCISE
  REST
}

/// D-236 — **루틴의 한 항목.** 운동이거나 휴식이다.
///
/// ## ⚠️ 이름이 `RoutineExercise` 가 아닌 이유
/// 휴식이 들어가는 테이블을 그렇게 부르면 **읽는 사람이 매번 속는다.** 이
/// 저장소가 반복해 겪은 실패다 — D-202(표시 URL 과 동작 URL 이 다른 함수) ·
/// D-220(닉네임이 없는데 닉네임으로 부름).
///
/// ## ⚠️ 세트 수 컬럼이 없다 — `reps` 배열 길이가 세트 수다 (D-236)
/// `sets = 4` 인데 `reps` 가 3칸이면 어느 것이 맞는지 정해야 하고, 그 분기를
/// 모든 조회 경로가 갖게 된다. 파생값은 저장하지 않는다 (D-073).
///
/// ## ⚠️ 휴식이 두 종류다 — 헷갈리게 두지 않는다
/// | 필드 | 무엇 | 어디 |
/// |---|---|---|
/// | `restSeconds` | **세트 사이** 휴식 (한 운동 안에서 반복된다) | 운동 항목 |
/// | `restDurationSeconds` | **운동 사이** 휴식 (이 항목 자체가 휴식이다) | 휴식 항목 |
///
/// ## ⚠️ `kind` 정합성은 애플리케이션이 지킨다
/// `EXERCISE` 면 `exerciseId` 가, `REST` 면 `restDurationSeconds` 가 있어야 한다.
/// DB CHECK 가 이상적이지만 **Prisma 가 CHECK 를 모델링하지 못해** 다음
/// `migrate diff` 가 그것을 보지 못한다. 대신 **쓰기 경로를 한 곳으로 모았다**
/// (`lib/routine-entry.ts`) — D-190·D-197 의 "규칙은 한 곳에" 그대로다.
model RoutineEntry {
  id String @id @default(cuid())

  /// 이 항목이 매달린 루틴 (운동 카테고리의 아이템)
  routineItemId String
  routine       Item   @relation(fields: [routineItemId], references: [id], onDelete: Cascade)

  kind RoutineEntryKind @default(EXERCISE)

  /// 담긴 운동 = 어드민 마스터. **휴식 항목에서는 `null`** 이다 (D-227·D-236)
  exerciseId String?
  exercise   Exercise? @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  /// 루틴 안에서의 순서 (`FR-10-B-02`)
  displayOrder Int @default(0)

  // ── 운동 항목의 내 설정 (D-166 의 타입을 옮긴 것) ─────────────────────────
  /// **세트별 횟수** (D-236). 배열 길이가 세트 수다.
  /// ⚠️ 각 칸이 문자열인 것은 실무 표기가 범위이기 때문이다 ("6-8", "AMRAP", D-166)
  reps           String[]
  /// **세트 사이** 휴식 (초). 단위 없이 두면 초인지 분인지 알 수 없다 (D-166)
  restSeconds    Int?
  /// 작업 중량 (kg). 소수를 쓰므로 정수가 아니다 (2.5kg 원판)
  workingWeight  Decimal? @db.Decimal(6, 2)
  /// 자각 강도 — 중량만으로는 자극 크기를 알 수 없다 (D-166)
  rpe            Decimal? @db.Decimal(3, 1)
  /// 템포 ("3-1-1-0")
  tempo          String?
  /// 머신 세팅 메모 ("시트 4, 핀 7") — 종목마다 고정값이라 항목으로 승격했다 (D-166)
  machineSetting String?

  // ── 휴식 항목 ─────────────────────────────────────────────────────────────
  /// **운동 사이** 휴식 (초). 화면에서는 분/초로 입력받아 초로 저장한다 (D-236).
  /// ⚠️ 분과 초를 따로 저장하지 않는다 — `3분 0초` 와 `180초` 가 다른 값으로
  /// 남으면 비교·합산이 갈린다. 표시할 때 다시 분/초로 나눈다
  restDurationSeconds Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// ⚠️ 한 루틴에 같은 운동이 두 번 들어가지 못한다 (`FR-10-B-03`).
  /// **Postgres 는 `NULL` 을 서로 다른 값으로 취급**하므로 휴식 행
  /// (`exerciseId = null`)은 **여러 개가 허용되고** 운동만 중복이 막힌다 —
  /// 제약 하나가 두 규칙을 정확히 표현한다 (D-236)
  @@unique([routineItemId, exerciseId])
  @@index([routineItemId, displayOrder])
  @@index([exerciseId])
}
