# 이 파일을 `.env`로 복사해 채운다. `.env`는 커밋하지 않는다.

# PostgreSQL. 로컬은 `pnpm db:local`(prisma dev)로 띄울 수 있다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/my_heritage?schema=public"

# 소셜 로그인 — Google / Apple만 (D-021). 이메일·비밀번호 가입은 제공하지 않는다.
# Kakao·LINE은 계정 병합 정책 확정 후 P2 (F-05 설계 의도).
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# 문의 이메일 (S-20 / FR-07-D-02). 운영 주체·SLA 미정 — OI-32
NEXT_PUBLIC_CONTACT_EMAIL=""
