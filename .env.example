# 이 파일을 `.env.local` 로 복사해 채운다. `.env.local` 은 커밋하지 않는다.
#
# ⚠️ **`.env` 로 복사하지 마라.** Next.js 와 `prisma/env.ts` 는 `.env.local` 을
#    먼저 읽고 먼저 읽은 쪽이 이긴다. 두 파일에 같은 키가 있으면 `.env` 쪽은
#    죽은 값이 되어 "고쳐도 반영되지 않는" 상태가 된다 (2026-09-03 에 실제로
#    `DATABASE_URL`·`AUTH_SECRET` 이 그 상태였다). 로컬 파일은 하나로 유지한다.

# ─────────────────────────────────────────────────────────
# PostgreSQL — 프로덕션은 URL 이 **두 개** 필요하다 (DEPLOY.md §2)
# ─────────────────────────────────────────────────────────
# 런타임용. 프로덕션에서는 **반드시 풀링된** 문자열을 쓴다 (`-pooler` 호스트).
# 직접 연결을 쓰면 서버리스 인스턴스가 늘어날 때 max_connections 를 넘겨
# 전부 500 이 된다.
#
# 로컬은 `pnpm db:up`(docker compose)로 띄운다.
# ⚠️ 포트가 5432 가 아니라 **5434** 다 — 같은 머신의 다른 프로젝트가 5432·5433 을
#    쓰고 있어서다. compose.yml 의 포트와 반드시 일치해야 한다.
DATABASE_URL="postgresql://heritage:heritage@localhost:5434/my_heritage?schema=public"

# 마이그레이션·시드용 **직접(session) 연결**. 풀러의 transaction 모드는 advisory
# lock 을 지원하지 않아 `prisma migrate` 가 실패한다.
#
# ⚠️ **비워두지 마라.** prisma.config.ts 의 우선순위는
#      DIRECT_URL || POSTGRES_URL_NON_POOLING || DATABASE_URL
#    이므로, 아래 Supabase 변수들이 .env.local 에 함께 있으면 비어 있는 DIRECT_URL
#    대신 **POSTGRES_URL_NON_POOLING(운영 DB)** 이 이긴다. 앱은 로컬 5434 를 보는데
#    `pnpm db:migrate` 는 운영 DB 에 걸리는 상태가 된다 (2026-08-18 에 실제 발생).
#    로컬 개발이라면 DATABASE_URL 과 같은 값을 명시적으로 적어라.
DIRECT_URL="postgresql://heritage:heritage@localhost:5434/my_heritage?schema=public"

# `prisma migrate dev` / `migrate diff --from-migrations` 가 마이그레이션을 재생할
# 빈 shadow DB. 로컬 컨테이너 안에 별도 DB 를 만들어 쓴다:
#   docker exec my-heritage-postgres psql -U heritage -d postgres \
#     -c 'CREATE DATABASE my_heritage_shadow OWNER heritage;'
# ⚠️ 운영 DB 를 shadow 로 쓰면 초기화된다. 절대 원격 URL 을 넣지 마라.
SHADOW_DATABASE_URL="postgresql://heritage:heritage@localhost:5434/my_heritage_shadow?schema=public"

# ⚠️ Supabase·Vercel 연동을 쓰면 위 두 개를 **손으로 적지 않아도 된다.**
#    코드가 주입된 이름을 그대로 읽는다 (src/lib/db-url.ts):
#      POSTGRES_PRISMA_URL      (6543, pgbouncer=true) → 런타임
#      POSTGRES_URL_NON_POOLING (5432, session 모드)   → 마이그레이션
#    POSTGRES_URL 은 쓰지 않는다 — 6543 인데 pgbouncer 플래그가 없어 가장 헷갈린다.
#    `pnpm db:which` 로 지금 어느 DB 를 보는지 확인할 수 있다.

# 소셜 로그인 — Google / Apple만 (D-021). 이메일·비밀번호 가입은 제공하지 않는다.
# Kakao·LINE은 계정 병합 정책 확정 후 P2 (F-05 설계 의도).
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# 절대 URL 생성용 (sitemap·robots·canonical·hreflang). 프로토콜 포함, 끝에 / 없이.
# 미설정 시 개발 기본값 http://localhost:3002 를 쓴다.
NEXT_PUBLIC_SITE_URL="https://example.com"

# 문의 이메일 (S-20 / FR-07-D-02). 운영 주체·SLA 미정 — OI-32
NEXT_PUBLIC_CONTACT_EMAIL=""

# ─────────────────────────────────────────────────────────
# 이미지 스토리지 — Supabase Storage (D-114. D-101 의 Vercel Blob 은 폐기)
# ─────────────────────────────────────────────────────────
# ⚠️ **서비스 롤 키는 RLS 를 우회한다.** NEXT_PUBLIC_ 접두사를 붙이지 않는다 —
#    브라우저에 닿으면 누구나 스토리지를 읽고 쓸 수 있다. 서버에서만 쓴다.
# Supabase 연동을 쓰면 이미 주입돼 있다 (SUPABASE_SECRET_KEY 도 인식한다).
SUPABASE_SERVICE_ROLE_KEY=""
# NEXT_PUBLIC_SUPABASE_URL 은 Supabase 연동이 함께 주입한다.
#
# ⚠️ 버킷 생성이 **출시 순서에 포함된다**: `pnpm storage:init`
#    없으면 업로드가 전부 실패하고, 사진이 필수라 아이템 등록이 막힌다.
# 로컬은 위 두 개를 비워두면 `public/uploads` 에 쓴다 (개발 모드에서만).

# ── 개발용 어드민 사칭 (D-117)
# 로컬을 원격 DB 에 붙이면 어드민 계정이 이미 있어 개발 우회로가 꺼지는데,
# OAuth 자격증명이 없으면 로그인도 못 해 /admin 이 닫힌다. 그 고리를 끊는 값.
# ⚠️ NODE_ENV=development 에서만 작동하고, 실재하는 활성 AdminUser 여야 한다.
# DEV_ADMIN_EMAIL=""

# ── 봇 콘텐츠 시딩 (D-146·D-149) — A-15, 로컬 전용
# 글 생성은 **로컬 Claude Code CLI** 를 부른다. API 키가 필요 없다.
# PATH 에 `claude` 가 있으면 아무것도 설정하지 않아도 된다.
# 없거나 다른 경로면 여기에 절대 경로를 지정한다.
# CLAUDE_CLI_PATH="/Users/me/.local/bin/claude"

# ─────────────────────────────────────────────────────────
# 신호등 잔여시간 API (`/api/signal`)
# ─────────────────────────────────────────────────────────
# 비워도 동작한다 — `GET /api/signal` 은 외부 API 를 아예 부르지 않고
# `src/lib/signal/lights.ts` 의 측정 주기로만 계산한다.
#
# 서울교통 빅데이터 포털(t-data.seoul.go.kr) 인증키. "신호제어기 신호 정보
# 서비스"용. **`POST /api/signal/sync` 에서만 쓴다** — 그 포털은 개발 활용신청
# 기준 하루 1,000건이라 상시 폴링에 쓸 수 없다. 동기화 1건으로 기준 시각을
# 맞추고 그 뒤로는 계산으로 버티는 구조다.
#
# ⚠️ 집앞 교차로가 **개방 대상인지**는 itstId 로 조회해봐야 안다 — 키가 있어도
# 대상이 아니면 응답에 그 방위 필드가 없어 동기화가 502 로 거절한다.
TDATA_API_KEY=""

# ── 포털 호출 자체 상한 (선택). 하루 1,000건을 통째로 태우지 않기 위한 안전판
# ⚠️ **보정 성공 건수가 아니라 호출 수**를 센다 (`SignalPortalCall`). 황색·모순으로
#    보정을 거절해도 포털은 이미 불렀으므로, 결과로 세면 집계가 샌다.
#    실시간 현시 조회·교차로 목록 수집이 모두 여기 포함된다.
# SIGNAL_PORTAL_DAILY_LIMIT="50"      # 하루 호출 건수 (기본 50, 옛 이름 SIGNAL_SYNC_DAILY_LIMIT 도 인식)
# SIGNAL_SYNC_MIN_INTERVAL_SEC="30"   # 같은 대상 연속 호출 최소 간격 (기본 30초)

# ── 교차로 목록 엔드포인트 (선택). 「교차로 Map 정보」 — itstId·좌표를 여기서 받는다.
#    화면의 '신호등 찾기'가 좌표로 교차로를 찾을 때 한 번 수집해 DB 에 넣는다
# TDATA_MAP_ENDPOINT=""

# 신호등 등록부를 코드 대신 환경변수로 둘 때 (구조는 lights.ts 의 SignalLight[]).
# 주기를 재측정할 때마다 배포하지 않으려면 이쪽을 쓴다.
# ⚠️ greenStartAt 에는 **오프셋(+09:00)을 반드시** 넣는다 — 배포 서버는 UTC 다.
# SIGNAL_LIGHTS_JSON='[{"id":"home","name":"집앞 횡단보도","calibrated":true,"cycle":[{"greenStartAt":"2026-09-10T21:03:07+09:00","greenSec":32,"redSec":88}]}]'

# ── 실시간 응답 형태를 확인한 뒤 고정하는 값들 (선택)
# 포털 문서가 잔여시간 필드명·단위를 밝히지 않아 어댑터가 추측한다. 실제 응답을
# 한 번 보고 여기에 박으면 추측이 사라진다.
# TDATA_REMAINING_FIELD="Rmdr"     # 접미만 주면 방위·종별 접두는 코드가 붙인다
# TDATA_REMAINING_UNIT="ds"        # s | ds(1/10초) | cs(1/100초). 기본은 자동 판정
# TDATA_SIGNAL_ENDPOINT=""         # 게이트웨이 주소가 바뀌었을 때만

# ─────────────────────────────────────────────────────────
# 행정안전부 한국지역정보개발원 — 교통안전 신호등 실시간 정보 (`/api/signal`)
# ─────────────────────────────────────────────────────────
# 공공데이터포털(data.go.kr) 인증키. **URL 인코딩된 일반 인증키를 그대로** 넣는다
# — 코드가 쿼리스트링에 문자열로 잇는다. 다시 인코딩하면 %2F 가 %252F 가 되어
# 인증이 깨진다.
#
# ⚠️ **서울 T-Data 보다 이쪽이 낫다.** 한 응답에 **상태와 잔여시간이 함께** 오고
#    교차로 좌표 목록도 같은 키로 열린다. T-Data 는 잔여시간만 주고 상태·좌표는
#    활용신청이 따로라 404 였다 (D-317).
#
# ⚠️ **실시간이 담긴 곳은 울산뿐이다** (2026-09-11 실측: 좌표 4,239건 = 서울
#    2,779 · 제주 1,058 · 울산 402, 실시간 398건 = 울산). 데이터셋 이름이
#    "전국 통합데이터" 라고 전국이 되는 것이 아니다.
POLICE_SIGNAL_API_KEY=""

# ⚠️ **인코딩본(Encoding)을 그대로** 넣는다. 코드가 쿼리스트링에 문자열로 이으므로
#    이미 인코딩된 값이 맞다 — 디코딩본을 넣으면 `/` 가 그대로 나가 깨진다.
#    게이트웨이 가이드의 "인증키(Decoding)을 입력" 은 **Swagger-UI 입력창 기준**
#    이다(UI 가 대신 인코딩한다). 여기와는 반대다.
#
# 명세(Swagger): https://ido.sharedata.go.kr/dcat/swagger/swagger-d0007.json
#   오퍼레이션은 `crsrd_map_info`(좌표)·`tl_drct_info`(실시간) 둘뿐이고
#   파라미터도 `serviceKey`·`stdgCd`(지자체 코드) 둘뿐이다.

# 게이트웨이 주소가 바뀌었을 때만 (기본: https://apis.data.go.kr/B551982/rti)
# KLID_SIGNAL_ENDPOINT=""
