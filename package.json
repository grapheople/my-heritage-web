{
  "name": "my-heritage-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3002",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:local": "prisma dev",
    "prisma:format": "prisma format",
    "postinstall": "prisma generate",
    "db:import-brands": "tsx prisma/import-brands.ts",
    "db:export-brands": "tsx prisma/export-brands.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v",
    "db:seed-dev": "tsx prisma/seed-dev.ts",
    "admin:add": "tsx prisma/add-admin.ts",
    "db:which": "tsx prisma/which-db.ts",
    "storage:init": "tsx prisma/storage-init.ts",
    "dev:docker": "DATABASE_URL=\"postgresql://heritage:heritage@localhost:5434/my_heritage?schema=public\" DIRECT_URL=\"postgresql://heritage:heritage@localhost:5434/my_heritage?schema=public\" next dev --port 3002",
    "attrs:bootstrap": "tsx prisma/bootstrap-attributes.ts",
    "attrs:drop-price": "tsx prisma/deactivate-purchase-price.ts",
    "attrs:workout": "tsx prisma/setup-workout-category.ts",
    "attrs:relax-keys": "tsx prisma/relax-matching-keys.ts",
    "db:research-codex": "tsx prisma/research-codex.ts",
    "db:backfill-match-keys": "tsx prisma/backfill-match-keys.ts",
    "mcp": "tsx mcp/server.ts",
    "attrs:camping": "tsx prisma/setup-camping-subtypes.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.112.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "pg": "^8.22.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.16.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.2.2"
}
