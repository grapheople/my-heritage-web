/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated by prisma-client generator
/src/generated

# 로컬 개발 업로드 (D-101). 프로덕션은 Vercel Blob 이다
/public/uploads

.idea/

# 근육맵 미리보기 산출물 (D-239) — 생성물이므로 커밋하지 않는다. 스크립트가 SoT 다
/.muscle-preview/

# 도감 분류 제안 (D-257) — 재생성 가능하고 --apply 후에는 stale 이다.
# 커밋하면 "적용된 제안"이 미적용인 것처럼 남는다. brands.csv 는 SoT 라 다르다
prisma/data/classify-*.csv
